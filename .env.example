# ---- splash config API ----
SPLASH_BASE_URL=http://37.27.203.234:8080
SPLASH_CLIENT_KEY=
SPLASH_DEVICE_ID=
SPLASH_TIMEOUT=15s

# ---- check-host.net ----
CHECKHOST_BASE_URL=https://check-host.net
IR_NODES=ir1,ir2,ir3,ir4,ir5,ir6,ir7,ir8
# Control nodes outside Iran. Without at least one, a server that is simply
# down cannot be told apart from one blocked in Iran. Leave empty to disable.
CONTROL_NODES=de1,nl1
# check-host does not document its rate limits, so stay slow on purpose.
CHECKHOST_RPS_DELAY=2s
POLL_INTERVAL=3s
RESULT_TIMEOUT=45s

# ---- verdict logic ----
# Iranian probes must fail at least this many times before a block is declared.
MIN_IR_FAIL=6
# A failure verdict is re-probed this many times before it is recorded.
CONFIRM_ROUNDS=2
CONFIRM_DELAY=30s

# ---- traceroute ----
TRACEROUTE_ENABLED=true
TRACEROUTE_NODES=ir1
TRACEROUTE_TIMEOUT=150s

# ---- scheduling and retention ----
# 0 disables the schedule and leaves scans manual only.
SCAN_INTERVAL=30m
SCAN_INITIAL_DELAY=10s
RETENTION_DAYS=90

# ---- dashboard ----
DASHBOARD_USER=admin
# Required. The service refuses to start without it.
DASHBOARD_PASS=
DASHBOARD_REFRESH=60
DASHBOARD_TIMEZONE=Asia/Tehran

# ---- service ----
APP_PORT=8081
HOST_PORT=8081
DB_PATH=/data/botchecker.db
LOG_LEVEL=info

# ============================================================
# Phase 2 — reacting to a block
#
# Everything below is OPTIONAL here: the same values can be entered in the
# dashboard under /settings, and a value saved there overrides the variable.
# ============================================================

# Encrypts the tokens stored by the dashboard. Leave empty and a key is
# generated on first run next to the database as secret.key (mode 0600).
# Lose that file and the stored tokens must be entered again.
ENCRYPTION_KEY=

# ---- watch loop ----
# Blocked addresses are re-probed this often; only they are, so the extra
# load on check-host stays small.
WATCH_INTERVAL=8m
OUTAGE_THRESHOLD=3
OUTAGE_WINDOW=30m

# ---- telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10s

# ---- 3x-ui panel (optional) ----
# Without it everything still works; alerts just cannot say how many users
# are online on a blocked server.
XUI_BASE_URL=
XUI_API_TOKEN=
XUI_TIMEOUT=10s
XUI_INSECURE_TLS=false

# ---- hetzner ----
# The token is also what tells your own addresses apart from ones hosted
# elsewhere, which cannot be replaced automatically.
HETZNER_TOKEN=
HETZNER_SNAPSHOT_ID=
HETZNER_SERVER_TYPE=cpx11
HETZNER_LOCATION=hel1
HETZNER_SSH_KEYS=
HETZNER_NAME_PREFIX=botchecker-
HETZNER_TIMEOUT=30s
HETZNER_INVENTORY_TTL=10m

# ---- provisioning safety ----
# Creating servers spends money. Both of these must be changed deliberately.
PROVISION_ENABLED=false
PROVISION_DRY_RUN=true
PROVISION_COOLDOWN=6h
PROVISION_MAX_PER_DAY=3
PROVISION_BOOT_WAIT=90s
PROVISION_VERIFY_ROUNDS=3
PROVISION_VERIFY_DELAY=60s
PROVISION_ACTION_TIMEOUT=5m

# ---- telegram bot commands (phase 3) ----
# Off by default: the bot only sends alerts. Turning it on lets it receive
# button presses, so the allow list decides who can control this service.
TELEGRAM_BOT_ENABLED=false
# Comma-separated numeric Telegram user ids. Empty falls back to
# TELEGRAM_CHAT_ID. Anyone else is ignored without a reply.
TELEGRAM_ALLOWED_IDS=

# ============================================================
# Phase 4 — replacing a blocked server for real
# ============================================================

# ---- Zex VPN admin panel ----
# The panel that hands configs to the app. With it configured, a blocked
# address is taken out of circulation and its configs are moved onto the
# replacement automatically. Without it, the service can only create a server
# and report the new address.
ZEX_BASE_URL=http://37.27.203.234:8080
ZEX_ADMIN_EMAIL=
ZEX_ADMIN_PASSWORD=
ZEX_TIMEOUT=20s

# How long the broken address's configs stay switched off before the swap.
# A floor, not an extra delay: building and verifying usually take longer.
PROVISION_QUIET_WINDOW=10m

# Which Hetzner locations sit in which country. A replacement is created in a
# country whose addresses are ALL healthy from Iran; locations are tried in
# the order listed.
HETZNER_LOCATION_MAP=FI:hel1,DE:fsn1,DE:nbg1,US:ash,US:hil,SG:sin

# all: re-probe every endpoint every WATCH_INTERVAL, so a healthy address that
# gets filtered is caught within minutes rather than at the next full scan.
# blocked: only re-probe the already-blocked ones.
WATCH_SCOPE=all

# Endpoints probed even though the splash API does not return them, as
# address:port or address:port:CC, comma separated. The splash query filters on
# is_active, so a server whose configs have been switched off disappears from
# monitoring — including during a replacement's own quiet window, and when a
# machine is still carrying users on links they cached earlier.
EXTRA_TARGETS=
